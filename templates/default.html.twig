{# Quark's standard page, with the page extras (the Git Sync link and the Creative Commons license) after the
   content, centred - hibbittsdesign.org #}
{% extends 'partials/base.html.twig' %}

{# A page in a guide's folder that isn't one of its sections (such as Topics or Resources): a link back to the guide at
   the top, as on the guide's own pages (left out when embedded, which shows content only) #}
{% set in_guide = page.parent.template == 'section-list' and not (embedded_mode or theme_var('chromeless.enabled')) %}

{% block content %}
    {% if in_guide %}
        <nav class="reader-top-bar" aria-label="{{ page.parent.title|e('html_attr') }}">
            <p class="reader-back-link"><a href="{{ page.parent.url }}"><i class="fa fa-chevron-left" aria-hidden="true"></i> {{ page.parent.menu }}</a></p>
        </nav>
    {% endif %}
    {{ page.content|raw }}
    {% include 'partials/page_extras.html.twig' with { inline: true } %}
{% endblock %}
