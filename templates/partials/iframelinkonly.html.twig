{# single line formatting for Page Inject Plugin compatibility; a site address (starting with /) gets the base URL, as in Open Matter - hibbittsdesign.org #}
{% block content %}{% set iframesource = page.header.iframe_source|first == '/' ? base_url ~ page.header.iframe_source : page.header.iframe_source %}<a class="newwindow external-link" href="{{ iframesource }}">{{ page.header.iframe_title }}</a><br>{% endblock %}
