{# Search box for the SimpleSearch plugin - a plain Spectre form, with no plugin JavaScript - hibbittsdesign.org #}
{# On a Multi-Page Content (Section List) page, search_scope limits the search to that page and the pages inside it;
   on a limited results page, search_scope_page keeps the limit for the next search #}
{% set search_action = base_url_relative ~ (search_route ?? '/search') %}
{% set search_min = config.plugins.simplesearch.min_query_length ?? 3 %}
{% set box_scope = search_scope ?? search_scope_page ?? null %}
{% if box_scope %}
    {% set search_placeholder = 'THEME_QUARK_OPEN_PUBLISHING.SEARCH_SCOPE_PLACEHOLDER'|t %}
{% else %}
    {% set search_placeholder = 'THEME_QUARK_OPEN_PUBLISHING.SEARCH_PLACEHOLDER'|t %}
{% endif %}
<form class="search-box" role="search" action="{{ search_action }}" method="get">
    <input class="form-input" type="search" name="query" value="{{ query|e }}" placeholder="{{ search_placeholder }}" aria-label="{{ search_placeholder }}" {% if search_min > 0 %}minlength="{{ search_min }}"{% endif %} required>
    {% if box_scope %}
        {# rawRoute, for example /open-education-essentials, stays the same when the page is the site's home page (whose route is /) #}
        <input type="hidden" name="scope" value="{{ box_scope.rawRoute|e('html_attr') }}">
    {% endif %}
</form>
