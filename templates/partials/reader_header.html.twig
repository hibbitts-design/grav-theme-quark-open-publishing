{# Reader details on the reader home (Multi-Section or Section List page): subtitle, cover image, author(s), edition and license (as in Helios Open Reader) - hibbittsdesign.org #}
{% set cover = page.header.cover_image ? page.media[page.header.cover_image] : null %}
{% if page.header.subtitle or cover or page.header.authors or page.header.edition or page.header.license %}
    <div class="reader-header">
        {% if cover %}
            <img class="reader-cover img-responsive" src="{{ cover.url }}" alt="{{ 'THEME_QUARK_OPEN_PUBLISHING.READER_COVER'|t(page.title) }}">
        {% endif %}
        <div class="reader-details">
            {% if page.header.subtitle %}
                <p class="reader-subtitle">{{ page.header.subtitle }}</p>
            {% endif %}
            {% if page.header.authors %}
                <p class="reader-authors">{{ page.header.authors }}</p>
            {% endif %}
            {% if page.header.edition %}
                <p class="reader-edition">{{ page.header.edition }}</p>
            {% endif %}
            {% if page.header.license %}
                <p><span class="label label-rounded reader-license">{{ page.header.license }}</span></p>
            {% endif %}
        </div>
    </div>
{% endif %}
