{# Reader details on the reader home (Multi-Section or Section List page): subtitle, cover image, author(s), edition, last updated date and license (as in Helios Open Reader) - hibbittsdesign.org #}
{# hide_cover leaves the cover out here, when the Section List page shows it large at the top instead;
   show_title puts the page title at the top of the details, beside a small cover (Section List pages);
   start_url and start_text add the Start button at the end of the details (Section List pages) #}
{% set hide_cover = hide_cover ?? false %}
{% set show_title = show_title ?? false %}
{% set start_url = start_url ?? '' %}
{% set cover = (page.header.cover_image and not hide_cover) ? page.media[page.header.cover_image] : null %}
{% if page.header.subtitle or cover or page.header.authors or page.header.edition or page.header.last_updated or page.header.license or start_url %}
    <div class="reader-header">
        {% if cover %}
            {# a portrait cover, such as a book cover, is shown whole on a Section List page, instead of cropped
               to the usual 4:3 shape (see css/reader.css) #}
            {% set cover_class = 'reader-cover img-responsive' %}
            {% if cover.get('height') > cover.get('width') %}
                {% set cover_class = cover_class ~ ' reader-cover-portrait' %}
            {% endif %}
            {# the Cover Image Alt Text setting describes the picture for screen readers; without it, "<title> cover" #}
            {% set cover_alt = page.header.cover_image_alt ?: 'THEME_QUARK_OPEN_PUBLISHING.READER_COVER'|t(page.title) %}
            <img class="{{ cover_class }}" src="{{ cover.url }}" alt="{{ cover_alt }}">
        {% endif %}
        <div class="reader-details">
            {% if show_title %}
                <h1 class="sections-page-title-template h3">{{ page.title }}</h1>
            {% endif %}
            {% if page.header.subtitle %}
                <p class="reader-subtitle">{{ page.header.subtitle }}</p>
            {% endif %}
            {% if page.header.authors %}
                <p class="reader-authors">{{ page.header.authors }}</p>
            {% endif %}
            {# the edition and last updated date share one line, for example "First Edition, 2026 · Updated Oct 4, 2026" #}
            {% if page.header.edition or page.header.last_updated %}
                {# the last updated date, as a <time> tag with the date in a form computers can read (2026-10-04),
                   shown in the language's date format (Oct 4, 2026), inside the "Updated ..." text #}
                {% set updated_text = '' %}
                {% if page.header.last_updated %}
                    {% set updated_date = '<time datetime="' ~ page.header.last_updated|date('Y-m-d') ~ '">' ~ page.header.last_updated|date('THEME_QUARK_OPEN_PUBLISHING.READER_DATE_FORMAT'|t) ~ '</time>' %}
                    {% set updated_text = 'THEME_QUARK_OPEN_PUBLISHING.READER_UPDATED'|t(updated_date) %}
                {% endif %}
                {# with both, a dot between them that is only visual: screen readers hear a short pause (a hidden comma, with a space so the page's Markdown version reads "2026, Updated")
                   instead of "middle dot" #}
                {% set separator = '' %}
                {% if page.header.edition and updated_text %}
                    {% set separator = '<span class="text-assistive">, </span><span aria-hidden="true"> &middot; </span>' %}
                {% endif %}
                {# |raw keeps the theme's own HTML (the <time> tag and the dot), while |e makes the edition plain text, as Twig does
                   for other settings when autoescape is on. (The - in {{- and -}} removes the spaces and line breaks around
                   the text, so the line has no extra space.) #}
                <p class="reader-edition">
                    {{- (page.header.edition|e ~ separator ~ updated_text)|raw -}}
                </p>
            {% endif %}
            {% if page.header.license %}
                <p><span class="label label-rounded reader-license">{{ page.header.license }}</span></p>
            {% endif %}
            {% if start_url %}
                <p class="section-list-start">
                    <a class="btn btn-primary" href="{{ start_url }}">{{ start_text }} <i class="fa fa-chevron-right" aria-hidden="true"></i></a>
                </p>
            {% endif %}
        </div>
    </div>
{% endif %}
